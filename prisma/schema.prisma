// Modelo de datos del directorio.
//
// Dos decisiones de diseño que vienen de los requisitos del consultorio y
// conviene no perder de vista al leer el esquema:
//
//   1. Todo lo que define la estructura del sitio —ciudades, profesiones,
//      especialidades y padecimientos— es un catálogo administrable. Abrir
//      una especialidad nueva, o más adelante odontología, es dar de alta un
//      registro, nunca programar.
//
//   2. Una página de catálogo solo se publica cuando reúne un mínimo de
//      profesionales. Ese mínimo se guarda, no se codifica, porque el
//      criterio puede cambiar por ciudad y por especialidad.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Las direcciones de conexion viven en prisma.config.ts: desde Prisma 7
  // ya no se declaran acá.
}

// ----------------------------------------------------------------------
//  Catálogos
// ----------------------------------------------------------------------

model Ciudad {
  id           Int           @id @default(autoincrement())
  nombre       String
  slug         String        @unique
  estado       String        @default("Chihuahua")
  descripcion  String?
  /// Mínimo de profesionales para publicar las páginas de esta ciudad.
  /// Si es nulo, manda el valor general guardado en Ajuste.
  umbralMinimo Int?
  activa       Boolean       @default(true)
  orden        Int           @default(0)
  consultorios Consultorio[]

  @@index([activa, orden])
}

/// Tipo de profesional de la salud: médico, odontólogo, psicólogo…
/// Separar esto de la especialidad permite abrir otra profesión sin tocar
/// el código, con sus propias reglas de verificación.
model Profesion {
  id     String @id @default(cuid())
  nombre String
  slug   String @unique
  /// Toda profesión exige cédula profesional; solo algunas exigen además
  /// la certificación de un consejo de especialidad vigente.
  exigeConsejo   Boolean        @default(false)
  activa         Boolean        @default(true)
  especialidades Especialidad[]
  profesionales  Profesional[]
}

model Especialidad {
  id            String         @id @default(cuid())
  nombre        String
  slug          String         @unique
  /// Texto propio de la especialidad. Sin él la página sería contenido
  /// delgado y el buscador la ignora.
  descripcion   String?
  profesionId   String
  profesion     Profesion      @relation(fields: [profesionId], references: [id])
  umbralMinimo  Int?
  activa        Boolean        @default(true)
  orden         Int            @default(0)
  padecimientos Padecimiento[]
  profesionales ProfesionalEspecialidad[]

  @@index([activa, orden])
}

model Padecimiento {
  id             String       @id @default(cuid())
  nombre         String
  slug           String
  descripcion    String?
  especialidadId String
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id])
  activo         Boolean      @default(true)

  @@unique([especialidadId, slug])
}

// ----------------------------------------------------------------------
//  Profesionales
// ----------------------------------------------------------------------

/// Qué incluye el perfil de un profesional según lo que contrató.
///
/// El plan no decide si el perfil es verificado —eso no se vende— sino qué
/// herramientas tiene: foto, contacto directo por WhatsApp y agenda en
/// línea. Al lanzamiento todos entran en BASICO sin costo.
enum PlanSuscripcion {
  BASICO
  GOLD
  PREMIUM
}

enum EstadoPerfil {
  BORRADOR
  EN_REVISION
  PUBLICADO
  SUSPENDIDO
}

model Profesional {
  id          String       @id @default(cuid())
  nombre      String
  /// La dirección del perfil no lleva ciudad: un mismo profesional puede
  /// atender en Delicias y en Camargo, y su perfil es uno solo.
  slug        String       @unique
  profesionId String
  profesion   Profesion    @relation(fields: [profesionId], references: [id])
  semblanza   String?
  /// Aseguradoras y convenios, tal como los enuncia el consultorio.
  convenios   String?
  fotografia  String?
  telefono    String?
  correo      String?
  estado      EstadoPerfil @default(BORRADOR)

  plan        PlanSuscripcion @default(BASICO)
  /// Hasta cuándo está pagado. Vencido, el perfil sigue publicado pero
  /// vuelve a las herramientas del plan básico: se cobra el plan, nunca la
  /// presencia del médico en el directorio.
  planHasta   DateTime?

  /// Promedio y número de opiniones, ya calculados. Se guardan para no
  /// recorrer todas las opiniones en cada listado del directorio.
  calificacion     Float?
  numeroOpiniones  Int    @default(0)

  /// Cómo quiere enterarse de que alguien solicita consulta con él.
  avisoCorreo   Boolean @default(true)
  avisoWhatsapp Boolean @default(false)

  /// La suscripción recurrente en el procesador de pagos, si contrató con
  /// tarjeta. Se guarda el identificador porque es lo único con lo que se
  /// puede consultar o cancelar el cobro automático más adelante.
  suscripcionId     String? @unique
  /// Lo último que el procesador dijo de esa suscripción: `authorized`,
  /// `paused` o `cancelled`. Va como texto y no como enum porque es
  /// vocabulario del proveedor y no nuestro: un valor nuevo de su lado no
  /// tiene por qué tumbar una escritura del nuestro.
  suscripcionEstado String?

  especialidades ProfesionalEspecialidad[]
  consultorios   Consultorio[]
  verificaciones Verificacion[]
  pagos          Pago[]
  metricas       MetricaDiaria[]
  cerrados       PeriodoCerrado[]
  espera         EnEspera[]
  citas          Cita[]
  opiniones      Opinion[]
  invitaciones   InvitacionOpinion[]
  usuarios       Usuario[]
  creadoEn       DateTime @default(now())

  @@index([estado])
}

model ProfesionalEspecialidad {
  profesionalId  String
  especialidadId String
  principal      Boolean      @default(false)
  profesional    Profesional  @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id], onDelete: Cascade)

  @@id([profesionalId, especialidadId])
}

// ----------------------------------------------------------------------
//  Verificación
// ----------------------------------------------------------------------

enum TipoCredencial {
  CEDULA_PROFESIONAL
  CEDULA_ESPECIALIDAD
  CONSEJO_ESPECIALIDAD
}

enum EstadoVerificacion {
  PENDIENTE
  APROBADA
  RECHAZADA
  VENCIDA
}

/// Una credencial comprobada. Guarda la evidencia porque la promesa al
/// paciente —«perfil verificado»— tiene que poder sostenerse después.
model Verificacion {
  id            String             @id @default(cuid())
  profesionalId String
  profesional   Profesional        @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  tipo          TipoCredencial
  numero        String?
  institucion   String?
  /// Las certificaciones de consejo caducan; la cédula no.
  vigenteHasta  DateTime?
  estado        EstadoVerificacion @default(PENDIENTE)
  /// Qué devolvió el registro consultado, o el documento que entregó el
  /// profesional. Es la evidencia archivada.
  evidencia     String?
  revisadaPor   String?
  revisadaEn    DateTime?
  creadaEn      DateTime           @default(now())

  @@index([profesionalId, tipo])
  @@index([estado, vigenteHasta])
}

// ----------------------------------------------------------------------
//  Consultorios y agenda
// ----------------------------------------------------------------------

model Consultorio {
  /// Calendario de Google del médico, para el plan Premium. Lo que él
  /// apunte allá bloquea el horario acá, y lo que reserve un paciente acá
  /// aparece allá. Vacío: la agenda vive solo en el directorio.
  calendarioGoogleId String?

  id                String      @id @default(cuid())
  profesionalId     String
  profesional       Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  ciudadId          Int
  ciudad            Ciudad      @relation(fields: [ciudadId], references: [id])
  nombre            String
  direccion         String
  referencias       String?
  latitud           Float?
  longitud          Float?
  precioValoracion  Int?
  duracionCitaMin   Int         @default(30)
  activo            Boolean     @default(true)
  franjas           Franja[]
  horasCerradas     HoraCerrada[]
  citas             Cita[]

  @@index([ciudadId, activo])
}

/// Un tramo de atención semanal. De aquí salen los huecos que ve el
/// paciente, menos lo que ya está ocupado.
model Franja {
  id            String      @id @default(cuid())
  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  /// 0 = lunes … 6 = domingo
  dia           Int
  desde         String
  hasta         String

  @@index([consultorioId, dia])
}

enum EstadoCita {
  SOLICITADA
  AGENDADA
  CONFIRMADA
  CANCELADA
  ATENDIDA
  NO_ASISTIO
}

model Cita {
  id            String        @id @default(cuid())
  /// Lo que lleva el enlace que recibe el paciente para ver, cancelar o
  /// reprogramar su cita sin tener que crear una cuenta. Va aparte del
  /// identificador para poder invalidarlo sin tocar la cita.
  token         String        @unique @default(cuid())
  /// Identificador del evento en el calendario de Google del médico, para
  /// los perfiles que lo tienen conectado: permite borrarlo allá si la cita
  /// se cancela acá.
  eventoGoogleId String?
  profesionalId String
  profesional   Profesional   @relation(fields: [profesionalId], references: [id])
  consultorioId String
  consultorio   Consultorio   @relation(fields: [consultorioId], references: [id])
  pacienteId    String
  paciente      Paciente      @relation(fields: [pacienteId], references: [id])
  inicio        DateTime
  fin           DateTime
  estado        EstadoCita    @default(AGENDADA)
  /// web, whatsapp, facebook, instagram o panel
  origen        String        @default("web")
  motivo        String?
  creadaEn      DateTime      @default(now())
  avisos        Aviso[]

  @@index([profesionalId, inicio])
  @@index([consultorioId, inicio])
}

model Paciente {
  id             String   @id @default(cuid())
  nombre         String?
  telefono       String   @unique
  correo         String?
  consentimiento DateTime?
  bajaEn         DateTime?
  citas          Cita[]
  espera         EnEspera[]
  creadoEn       DateTime @default(now())
}

// ----------------------------------------------------------------------
//  Avisos al profesional
// ----------------------------------------------------------------------

enum CanalAviso {
  CORREO
  WHATSAPP
  PANEL
}

enum EstadoAviso {
  PENDIENTE
  ENVIADO
  FALLIDO
}

/// «Alguien está buscando consulta con usted». Se guarda cada intento
/// para poder responder si un profesional dice que no le llegó.
model Aviso {
  id        String      @id @default(cuid())
  citaId    String
  cita      Cita        @relation(fields: [citaId], references: [id], onDelete: Cascade)
  canal     CanalAviso
  destino   String
  estado    EstadoAviso @default(PENDIENTE)
  detalle   String?
  enviadoEn DateTime?
  creadoEn  DateTime    @default(now())

  @@index([estado, creadoEn])
}

// ----------------------------------------------------------------------
//  Opiniones, usuarios y operación
// ----------------------------------------------------------------------

/// Una invitación a opinar, emitida por el consultorio.
///
/// Existe para el paciente que se atendió de verdad pero no agendó por el
/// sitio: por teléfono, por WhatsApp o en el mostrador. Sin esto, atar la
/// opinión al enlace de la cita dejaba fuera a la mayoría de los
/// pacientes y el consultorio se quedaba sin forma de pedir su reseña.
///
/// `usadaEn` la vuelve de un solo uso y `emitidaPor` deja por escrito
/// quién la generó, porque una reseña que no respalda una cita registrada
/// tiene que poder explicarse después.
model InvitacionOpinion {
  id            String      @id @default(cuid())
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  /// El nombre con el que el consultorio conoce al paciente.
  paciente      String
  /// Teléfono o correo, para poder mandarle el enlace.
  contacto      String?
  atendidoEn    DateTime?
  nota          String?
  emitidaPor    String
  usadaEn       DateTime?
  creadaEn      DateTime    @default(now())
  opinion       Opinion?

  @@index([profesionalId, creadaEn])
}

/// La opinión de un paciente.
///
/// Se publica después de revisarla. `citaId` distingue la opinión de quien
/// sí tuvo consulta de la de cualquiera que pasó por el sitio, que es lo
/// que hace creíble la calificación. `invitacionId` cubre al paciente que
/// se atendió de verdad pero agendó por teléfono: la respalda el
/// consultorio en lugar de una cita registrada, y la moderación lo
/// distingue.
model Opinion {
  id            String      @id @default(cuid())
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  citaId        String?     @unique
  /// La invitación que la permitió, cuando no vino de una cita agendada
  /// por el sitio. Una invitación, una opinión.
  invitacionId  String?     @unique
  invitacion    InvitacionOpinion? @relation(fields: [invitacionId], references: [id], onDelete: SetNull)
  autor         String
  calificacion  Int
  texto         String
  publicada     Boolean     @default(false)
  revisadaPor   String?
  fecha         DateTime    @default(now())

  @@index([profesionalId, publicada])
}

/// Un paciente esperando que se libere un horario con un médico.
///
/// Existe porque una agenda llena hoy es un paciente perdido mañana: sin
/// esto, el hueco que deja una cancelación no lo ocupa nadie y el médico
/// se queda con la hora vacía y el paciente sin consulta.
model EnEspera {
  id            String      @id @default(cuid())
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  pacienteId    String
  paciente      Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  /// Desde cuándo le sirve, en AAAA-MM-DD. Vacío: cualquier fecha.
  desde         String?
  hasta         String?
  nota          String?
  /// Cuándo se le ofreció un hueco, para no ofrecerle dos seguidos ni
  /// saltárselo si todavía no contesta.
  avisadoEn     DateTime?
  /// Se atendió, se cansó de esperar o ya agendó por otro lado.
  cerradoEn     DateTime?
  creadoEn      DateTime    @default(now())

  @@index([profesionalId, cerradoEn, creadoEn])
}

/// Un periodo que el médico cerró: vacaciones, un congreso, una ausencia.
///
/// Se guarda como rango y no como un renglón por día porque así lo piensa
/// el médico —«del 20 al 28»— y porque corregir un periodo es tocar un
/// solo registro. El generador de huecos lo expande a días al leerlo.
/// Una hora suelta que el médico aparta porque ya la comprometió por
/// otro medio: una llamada, un WhatsApp, alguien que llegó al
/// consultorio. Sin esto el sitio seguía ofreciendo ese hueco y lo podía
/// tomar un segundo paciente.
model HoraCerrada {
  id            String      @id @default(cuid())
  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  /// AAAA-MM-DD, el día local del consultorio.
  fecha         String
  /// HH:MM, el inicio del hueco apartado.
  hora          String
  motivo        String?
  creadaPor     String?
  creadaEn      DateTime    @default(now())

  @@unique([consultorioId, fecha, hora])
  @@index([consultorioId, fecha])
}

model PeriodoCerrado {
  id            String      @id @default(cuid())
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  /// Días en formato AAAA-MM-DD: la agenda razona en fechas locales, y un
  /// instante UTC movería el corte del día seis horas.
  desde         String
  hasta         String
  motivo        String?
  creadoEn      DateTime    @default(now())

  @@index([profesionalId, desde])
}

/// Lo que pasó con un perfil en un día, ya sumado.
///
/// Se guarda agregado por día y no un renglón por visita: al médico le
/// sirve «cuántos me buscaron este mes», no la hora exacta de cada una, y
/// así la tabla crece un renglón diario por perfil en lugar de uno por
/// visita. Las citas no se cuentan acá porque ya están en su propia tabla
/// y contarlas dos veces es garantizar que algún día no cuadren.
/// Visitantes del sitio por día (navegadores distintos, sin el panel). Lo
/// cuenta el navegador una vez al día, así que los rastreadores no suman.
model VisitaDiaria {
  /// Medianoche del día, en hora de Chihuahua.
  dia     DateTime @id
  visitas Int      @default(0)
}

model MetricaDiaria {
  id            String      @id @default(cuid())
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  /// Medianoche del día, en hora de Chihuahua.
  dia           DateTime
  vistas        Int         @default(0)
  telefono      Int         @default(0)
  whatsapp      Int         @default(0)

  @@unique([profesionalId, dia])
  @@index([dia])
}

// ----------------------------------------------------------------------
//  Cobro de las suscripciones
// ----------------------------------------------------------------------

enum MedioPago {
  TRANSFERENCIA
  TARJETA
  /// Cortesía del consultorio: no entró dinero, pero el periodo corre.
  CORTESIA
}

enum EstadoPago {
  /// Se eligió el plan y se esperan los datos del depósito.
  PENDIENTE
  /// El médico ya reportó su comprobante y falta que alguien lo apruebe.
  EN_REVISION
  /// Confirmado. Es el único estado que mueve la fecha de vencimiento.
  ACREDITADO
  RECHAZADO
}

/// Un cobro de suscripción, del momento en que se elige el plan hasta que
/// se acredita. Queda como historia: el periodo que cubrió, quién lo
/// revisó y con qué folio se le dio recibo al médico.
model Pago {
  id            String          @id @default(cuid())
  profesionalId String
  profesional   Profesional     @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  plan          PlanSuscripcion
  /// 1 o 12. Se guarda el número y no la palabra para poder sumar meses.
  meses         Int
  /// En centavos de peso. Nunca decimales: sumar flotantes termina
  /// cobrando de más o de menos según la pantalla.
  importe       Int
  medio         MedioPago
  estado        EstadoPago      @default(PENDIENTE)

  /// Folio del recibo, correlativo por año. Solo al acreditarse.
  folio         String?         @unique
  /// Referencia bancaria o del procesador, tal como la reporta el médico.
  referencia    String?
  /// El identificador que el procesador le dio a este cobro.
  ///
  /// Único a propósito: un webhook se reintenta y llega repetido, y sin
  /// esto el mismo cobro se acreditaría dos veces y la suscripción ganaría
  /// un mes que nadie pagó.
  idExterno     String?         @unique
  /// Qué periodo quedó cubierto con este pago.
  periodoDesde  DateTime?
  periodoHasta  DateTime?

  revisadoPor   String?
  revisadoEn    DateTime?
  /// Por qué se rechazó, o la nota que deje quien lo revisó.
  detalle       String?
  creadoEn      DateTime        @default(now())

  @@index([profesionalId, creadoEn])
  @@index([estado, creadoEn])
}

enum Rol {
  ADMINISTRADOR
  RECEPCION
  PROFESIONAL
}

model Usuario {
  id            String       @id @default(cuid())
  nombre        String
  correo        String       @unique
  hashClave     String
  rol           Rol          @default(RECEPCION)
  /// Solo para el rol PROFESIONAL: a qué perfil da acceso.
  profesionalId String?
  profesional   Profesional? @relation(fields: [profesionalId], references: [id])
  activo        Boolean      @default(true)
  creadoEn      DateTime     @default(now())
}

/// Configuración que el panel puede cambiar sin un despliegue: nombre del
/// sitio, umbral general de publicación, textos legales.
model Ajuste {
  clave String @id
  valor String
}

enum EstadoSolicitud {
  RECIBIDA
  EN_VERIFICACION
  PUBLICADA
  RECHAZADA
}

/// Lo que llena un profesional que quiere aparecer en el directorio.
///
/// Se guarda aparte del perfil a propósito: hasta que alguien verifica la
/// cédula no hay perfil, solo una solicitud. Así el padrón publicado nunca
/// contiene nada sin revisar.
model SolicitudAlta {
  id            String          @id @default(cuid())
  nombre        String
  correo        String
  telefono      String
  profesionSlug String
  especialidad  String
  ciudadSlug    String
  cedula        String
  /// La que emite la SEP al terminar la residencia. No caduca.
  cedulaEspecialidad String?
  /// La que da el consejo de la especialidad. Se renueva.
  consejo       String?
  consultorio   String?
  mensaje       String?
  /// El plan que eligió al registrarse. El básico se aplica al publicar el
  /// perfil; los de pago quedan como cobro pendiente hasta acreditarse.
  plan          PlanSuscripcion @default(BASICO)
  /// MENSUAL o ANUAL, solo para los planes de pago.
  periodicidad  String?
  /// Referencia del depósito, si la reportó al registrarse.
  referenciaPago String?
  estado        EstadoSolicitud @default(RECIBIDA)
  revisadaPor   String?
  revisadaEn    DateTime?
  creadaEn      DateTime        @default(now())

  @@index([estado, creadaEn])
}

enum TipoNovedad {
  SOLICITUD_ALTA
  CITA_NUEVA
  CITA_CANCELADA
  OPINION_NUEVA
}

/// Lo que ocurrió y alguien del consultorio tiene que ver.
///
/// Existe aparte de la auditoría porque son cosas distintas: la auditoría
/// registra todo para poder explicarlo después; esto es una bandeja de
/// pendientes que se vacía. Vive en la base y no en el correo para que el
/// consultorio se entere aunque el envío falle o todavía no haya proveedor.
model Novedad {
  id            String      @id @default(cuid())
  tipo          TipoNovedad
  titulo        String
  detalle       String?
  /// A dónde lleva en el panel.
  enlace        String?
  /// A qué registro apunta, para poder apagar el aviso al resolverlo. Sin
  /// esto el aviso de un alta seguía ahí después de aprobarla.
  referencia    String?
  /// Si corresponde a un médico en particular, para que vea las suyas.
  profesionalId String?
  leidaEn       DateTime?
  /// Para no reintentar el correo al administrador en cada pasada.
  avisadaEn     DateTime?
  creadaEn      DateTime    @default(now())

  @@index([leidaEn, creadaEn])
  @@index([profesionalId, creadaEn])
  @@index([referencia, leidaEn])
}

model RegistroAuditoria {
  id        String   @id @default(cuid())
  actor     String
  accion    String
  entidad   String?
  entidadId String?
  detalle   String?
  cuando    DateTime @default(now())

  @@index([cuando])
}
